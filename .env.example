# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# SerpAPI
SERPAPI_API_KEY=

# Google Cloud Vision (JSON credentials as string or file path)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_CREDENTIALS_JSON=

# ScrapingBee
# Scrape.do (remplace ScrapingBee)
# ZenRows (scraping URL / Amazon / eBay / Utopya)
ZENROWS_API_KEY=
ZENROWS_PREMIUM=true
# Alias legacy (fallback si ZENROWS_API_KEY absent)
SCRAPINGBEE_API_KEY=
SCRAPE_DO_TOKEN=
# Session Utopya (pro) pour récupérer les prix : coller les cookies du navigateur connecté
# Format ScrapingBee : PHPSESSID=...; form_key=...
UTOPYA_COOKIES=

# eBay
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_MARKETPLACE_ID=EBAY_FR
EBAY_API_URL=https://api.sandbox.ebay.com
EBAY_AUTH_URL=https://auth.sandbox.ebay.com
EBAY_MOCK_MODE=false
ENCRYPTION_KEY=

# eBay Marketplace Account Deletion (Production keyset compliance)
# Must match the Verification Token entered in the eBay developer portal.
EBAY_DELETION_VERIFICATION_TOKEN=
# Exact public URL registered in the eBay portal (no trailing slash unless registered with one).
EBAY_DELETION_ENDPOINT_URL=https://snowolf-lime.vercel.app/api/ebay/account-deletion
# Never enable in production:
# EBAY_DELETION_SKIP_SIGNATURE=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Debug (development only)
DEBUG_MODE=false
