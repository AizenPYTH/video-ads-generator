# ---- Core ----
NODE_ENV=development
PORT=3001
# Comma-separated allowlist. Entries may start with `*.` to match a whole
# domain - include *.vercel.app or every preview deploy fails CORS.
# `*` on its own allows anything (development only).
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug

# Absolute URL the renderer (headless Chrome) uses to load capture assets.
# In production set this to the backend's public origin.
PUBLIC_BASE_URL=http://127.0.0.1:3001

# ---- Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-sonnet-5

# ---- Rendering ----
# Render each aspect ratio natively (best quality, ~3x slower).
# Set to false to render 9:16 once and reframe the other two with ffmpeg.
RENDER_NATIVE_ASPECTS=true
RENDER_CONCURRENCY=2
# Full Chromium used by Playwright for scraping. Blank = Playwright's own.
BROWSER_EXECUTABLE=
# chrome-headless-shell used by Remotion. Leave blank: the backend finds the
# shell that ships alongside Playwright's Chromium by itself. These are two
# different binaries - Remotion launches with the old --headless flag, which
# modern full Chrome builds reject.
REMOTION_BROWSER_EXECUTABLE=
# System ffmpeg. Leave blank to use the bundled ffmpeg-static binary.
FFMPEG_PATH=
SCRAPE_TIMEOUT_MS=45000

# ---- Storage ----
STORAGE_DIR=./storage
JOB_TTL_MS=21600000

# ---- Optional: durable queue (Bull) ----
REDIS_URL=

# ---- Optional: job persistence ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to true when a separate `npm run worker` process owns the queue.
DISABLE_INLINE_WORKER=false
