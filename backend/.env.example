# Every optional key below is listed with an empty value so you can see what
# exists. A blank value means "unset": the backend falls back to its default
# rather than handing an empty string to ffmpeg or the Anthropic client.
#
# ---- Core ----
NODE_ENV=development
PORT=3001
# Comma-separated allowlist of frontends allowed to call this API.
# All of these forms work and mean the same thing:
#   https://app.vercel.app   app.vercel.app   https://app.vercel.app/
#   *.vercel.app             https://*.vercel.app
# A leading *. matches any subdomain but not the apex, so *.vercel.app
# covers every Vercel preview deploy and still rejects notvercel.app.
# A scheme is honoured when given. Ports are part of the origin, so write
# localhost:5173, not localhost. `*` alone allows anything - dev only.
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug

# Absolute URL the renderer (headless Chrome) uses to load capture assets.
# In production set this to the backend's public origin.
PUBLIC_BASE_URL=http://127.0.0.1:3001

# ---- Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-sonnet-5

# ---- Rendering & memory ----
# Rendering is what gets a small container OOM-killed. Each of these is a
# lever; the defaults are sized for a ~1 GB Railway/Render instance.
#
# Render each aspect natively (3 headless Chrome sessions) instead of
# rendering 9:16 once and reframing the other two with ffmpeg.
RENDER_NATIVE_ASPECTS=false
# Frames in parallel. Each one is a Chrome tab holding a full frame buffer,
# so this multiplies peak memory directly.
RENDER_CONCURRENCY=1
# Short edge of the output. Compositions are authored at 1080 and scaled to
# this. 720 is 44% of the pixels of 1080; set 1080 if you have the memory.
VIDEO_SHORT_EDGE=720
# x264 quality: higher is smaller and cheaper to encode.
VIDEO_CRF=28
# x264 speed preset: faster presets use less memory for motion search.
X264_PRESET=veryfast
# Full Chromium used by Playwright for scraping. Blank = Playwright's own.
BROWSER_EXECUTABLE=
# chrome-headless-shell used by Remotion. Leave blank: the backend finds the
# shell that ships alongside Playwright's Chromium by itself. These are two
# different binaries - Remotion launches with the old --headless flag, which
# modern full Chrome builds reject.
REMOTION_BROWSER_EXECUTABLE=
# System ffmpeg. Leave blank to use the bundled ffmpeg-static binary.
FFMPEG_PATH=
SCRAPE_TIMEOUT_MS=45000

# ---- Storage ----
STORAGE_DIR=./storage
JOB_TTL_MS=21600000

# ---- Optional: durable queue (Bull) ----
REDIS_URL=

# ---- Optional: job persistence ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to true when a separate `npm run worker` process owns the queue.
DISABLE_INLINE_WORKER=false
